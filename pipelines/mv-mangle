#!/usr/bin/env bash
# mv-mangle — motion-vector glitching via FFglitch.
#
# 1. Re-encode to MPEG-4 with `-mpv_flags +forcemv+nopimb`.
#      forcemv: write motion vectors for P-frame macroblocks even when <0,0>.
#      nopimb:  forbid intra macroblocks in predictive frames.
#    Without BOTH, most macroblocks carry nothing to mangle and the effect is
#    sparse and blocky. Note these are values of -mpv_flags, NOT -flags.
# 2. Run an ffedit motion-vector script over the resulting bitstream.
# 3. Re-encode losslessly so the glitch survives chaining.
#
# Knobs that matter:
#   --qscale N   MPEG-4 quantizer, 1 (best) .. 31 (worst). Default 8. Lower
#                retains more macroblock detail, so displacement reads more
#                clearly; higher gives you blockier, mushier smear.
#   --gop N      GOP size, default 1000. Large => effectively one keyframe, so
#                displacement ACCUMULATES across the clip. Drop it to ~12 and
#                the glitch resets at every I-frame instead.
#   --amount N   Max per-axis MV displacement, default 8. Clamped to the codec's
#                legal fcode range by the script.
#   --seed N     PRNG seed, default 1. Pinned and recorded in the manifest.
#   --script F   ffedit script. Default scripts/mv-shuffle.js.
#
# Vendored upstream examples live in $FFGLITCH_SCRIPTS (pinned flake input).
# Many call Math.random(), which QuickJS cannot seed — those are NOT reproducible.

. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_lib.sh"

QSCALE=8 GOP=1000 AMOUNT=8 SEED=1 SCRIPT="" INPUT="" OUTPUT="" CHECK=""

usage() { sed -n '2,28p' "$0" | sed 's/^# \?//'; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case $1 in
    --qscale) QSCALE=$2; shift 2 ;;
    --gop)    GOP=$2; shift 2 ;;
    --amount) AMOUNT=$2; shift 2 ;;
    --seed)   SEED=$2; shift 2 ;;
    --script) SCRIPT=$2; shift 2 ;;
    -o|--output) OUTPUT=$2; shift 2 ;;
    --check) CHECK=1; shift ;;
    -h|--help) usage 0 ;;
    -*) vb_die "unknown flag: $1" ;;
    *)  INPUT=$1; shift ;;
  esac
done

vb_require_cmd ffgac
vb_require_cmd ffedit
vb_require_cmd ffmpeg
[ -n "$CHECK" ] && exit 0

[ -n "$INPUT" ] || usage 1
SCRIPT=${SCRIPT:-$(vb_root)/scripts/mv-shuffle.js}
[ -f "$SCRIPT" ] || vb_die "ffedit script not found: $SCRIPT"

PARAMS=$(jq -cS -n \
  --argjson qscale "$QSCALE" --argjson gop "$GOP" \
  --argjson amount "$AMOUNT" --argjson seed "$SEED" \
  --arg script "$(basename "$SCRIPT")" \
  --arg script_sha256 "$(vb_sha256 "$SCRIPT")" \
  '{qscale:$qscale,gop:$gop,amount:$amount,seed:$seed,
    script:$script,script_sha256:$script_sha256}')

TOOLS=$(jq -cS -n \
  --arg ffgac "$(vb_tool_version ffgac)" \
  --arg ffedit "$(vb_tool_version ffedit)" \
  --arg ffmpeg "$(vb_tool_version ffmpeg)" \
  '{ffgac:$ffgac,ffedit:$ffedit,ffmpeg:$ffmpeg}')

vb_begin mv-mangle "$INPUT" "$PARAMS" "$TOOLS"
OUTPUT=${OUTPUT:-$VB_RUN_DIR/out.mkv}

ENC="$VB_RUN_DIR/stage1-mpeg4.avi"
GLITCHED="$VB_RUN_DIR/stage2-glitched.avi"

vb_log "ffgac: mpeg4 q=$QSCALE gop=$GOP +forcemv+nopimb"
ffgac -hide_banner -nostdin -loglevel "${VB_LOGLEVEL:-error}" \
  -i "$INPUT" -an \
  -flags +bitexact -fflags +bitexact \
  -mpv_flags +forcemv+nopimb -qscale:v "$QSCALE" -g "$GOP" \
  -vcodec mpeg4 -f avi -y "$ENC"

vb_log "ffedit: mv script seed=$SEED amount=$AMOUNT"
# -t is ffedit's bitexact/test mode.
ffedit -t -i "$ENC" -f mv -s "$SCRIPT" \
  -sp "$(jq -cn --argjson seed "$SEED" --argjson amount "$AMOUNT" '{seed:$seed,amount:$amount}')" \
  -o "$GLITCHED" 2>/dev/null

vb_log "ffmpeg: lossless re-encode"
vb_ffmpeg -i "$GLITCHED" -- -c:v ffv1 -y "$OUTPUT"

vb_finish "$OUTPUT"
