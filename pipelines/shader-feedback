#!/usr/bin/env bash
# shader-feedback — headless glslViewer rendering a frag shader to a PNG
# sequence, with uniforms fed on stdin by this driver script.
#
# LINUX ONLY. glslviewer is marked broken on aarch64-darwin in nixpkgs ("never
# built on aarch64-darwin since first introduction") and its inputs are X11-only.
# Refuses to run on Darwin rather than failing three steps in.
#
# --headless is not display-free either: on the GLFW path it is only
# glfwWindowHint(GLFW_VISIBLE, GL_FALSE), a hidden window that still needs a
# display connection. glslviewer-headless wraps it in xvfb-run for that reason.
#
# WHY FRAME-BY-FRAME, NOT `sequence`:
#   glslViewer has a `sequence,<from>,<to>,<fps>` command that renders a PNG run
#   in one shot, and it is much faster. But stdin commands are not synchronised
#   to frame boundaries, so uniforms fed while `sequence` runs land at
#   nondeterministic frames. Commands ARE processed in order, so emitting
#   "set uniforms; screenshot" per frame is deterministic. Correctness over
#   speed — this repo's whole point is regenerable output.
#
# Uniform syntax on stdin is `name,v0[,v1,...]` (glslViewer splits on commas).
#
# Knobs that matter:
#   --frames N   Frame count. Default 120.
#   --size WxH   Render size. Default 640x480.
#   --fps N      Frame rate of the assembled video. Default 24.
#   --seed N     Fed to the shader as u_seed. Pinned + logged.
#   --amount F   Fed as u_amount — displacement strength. Default 0.5.
#   --decay F    Fed as u_decay — feedback persistence 0..1. Default 0.85.
#   --shader F   Fragment shader. Default shaders/feedback.frag.
#   --osc-port N Open an OSC listening port (glslViewer builds with SUPPORT_OSC
#                unconditionally). Off by default: an external OSC source is by
#                definition unpinned, so enabling it forfeits reproducibility.

. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_lib.sh"

FRAMES=120 SIZE=640x480 FPS=24 SEED=1 AMOUNT=0.5 DECAY=0.85
SHADER="" OSC_PORT="" OUTPUT="" CHECK=""

usage() { sed -n '2,38p' "$0" | sed 's/^# \?//'; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case $1 in
    --frames)   FRAMES=$2; shift 2 ;;
    --size)     SIZE=$2; shift 2 ;;
    --fps)      FPS=$2; shift 2 ;;
    --seed)     SEED=$2; shift 2 ;;
    --amount)   AMOUNT=$2; shift 2 ;;
    --decay)    DECAY=$2; shift 2 ;;
    --shader)   SHADER=$2; shift 2 ;;
    --osc-port) OSC_PORT=$2; shift 2 ;;
    -o|--output) OUTPUT=$2; shift 2 ;;
    --check)    CHECK=1; shift ;;
    -h|--help)  usage 0 ;;
    *) vb_die "unknown argument: $1" ;;
  esac
done

vb_require_linux \
  "shader-feedback is linux-only: nixpkgs marks glslviewer broken on aarch64-darwin
   (\"never built on aarch64-darwin since first introduction\"), and its build
   inputs are X11-only. Run this on the x86_64-linux host."

vb_require_cmd glslviewer-headless
vb_require_cmd ffmpeg
[ -n "$CHECK" ] && exit 0

SHADER=${SHADER:-$(vb_root)/shaders/feedback.frag}
[ -f "$SHADER" ] || vb_die "shader not found: $SHADER"
W=${SIZE%x*}; H=${SIZE#*x}

PARAMS=$(jq -cS -n \
  --argjson frames "$FRAMES" --argjson fps "$FPS" --argjson seed "$SEED" \
  --arg size "$SIZE" --arg amount "$AMOUNT" --arg decay "$DECAY" \
  --arg shader "$(basename "$SHADER")" \
  --arg shader_sha256 "$(vb_sha256 "$SHADER")" \
  --arg osc "${OSC_PORT:-disabled}" \
  '{frames:$frames,fps:$fps,seed:$seed,size:$size,amount:$amount,decay:$decay,
    shader:$shader,shader_sha256:$shader_sha256,osc:$osc}')

TOOLS=$(jq -cS -n \
  --arg gv "$(vb_tool_version glslViewer)" \
  --arg ffmpeg "$(vb_tool_version ffmpeg)" \
  '{glslViewer:$gv,ffmpeg:$ffmpeg}')

# The shader is the "input" for provenance purposes — there is no input media.
vb_begin shader-feedback "$SHADER" "$PARAMS" "$TOOLS"
OUTPUT=${OUTPUT:-$VB_RUN_DIR/out.mkv}
FRAMEDIR="$VB_RUN_DIR/frames"; mkdir -p "$FRAMEDIR"

declare -a osc_args=()
[ -n "$OSC_PORT" ] && osc_args=(-p "$OSC_PORT")

vb_log "glslViewer: ${W}x${H} ${FRAMES} frames seed=$SEED"
{
  printf 'u_seed,%s\n'   "$SEED"
  printf 'u_amount,%s\n' "$AMOUNT"
  printf 'u_decay,%s\n'  "$DECAY"
  for ((i = 0; i < FRAMES; i++)); do
    printf 'u_frame,%d\n' "$i"
    printf 'screenshot,%s\n' "$(printf '%s/frame_%05d.png' "$FRAMEDIR" "$i")"
  done
  printf 'exit\n'
} | glslviewer-headless "$SHADER" \
      --headless --noncurses -w "$W" -h "$H" "${osc_args[@]}" \
  || vb_die "glslViewer failed"

COUNT=$(find "$FRAMEDIR" -name 'frame_*.png' | wc -l | tr -d ' ')
[ "$COUNT" -eq "$FRAMES" ] || vb_die "expected $FRAMES frames, got $COUNT"

vb_log "ffmpeg: assembling $COUNT frames @ ${FPS}fps"
vb_ffmpeg -framerate "$FPS" -i "$FRAMEDIR/frame_%05d.png" -- -c:v ffv1 -y "$OUTPUT"

vb_finish "$OUTPUT"
