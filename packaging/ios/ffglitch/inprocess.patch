 #include <stdlib.h>
 #include "os_support.h"
 #include "url.h"
+#include <poll.h>
+
+/* ffglitch-ios: tools run inside the app. A blocking read()/write() on a pipe
+   would hang a cancelled or failed run forever, so wait in poll() slices and
+   give up when the run is interrupted. Every fd a run opens is registered
+   with the run, which closes the ones still open if it is abandoned; writes
+   to a closed pipe return EPIPE instead of raising SIGPIPE. */
+static int ffg_wait_fd(URLContext *h, int fd, short events)
+{
+    struct pollfd p = { .fd = fd, .events = events };
+    for (;;) {
+        int n;
+        if (ffg_io_interrupted() || ff_check_interrupt(&h->interrupt_callback))
+            return AVERROR_EXIT;
+        n = poll(&p, 1, 100);
+        if (n > 0 || (n < 0 && errno != EINTR && errno != EAGAIN))
+            return 0; /* ready, hung up, or an error read()/write() reports */
+    }
+}
 
+static void ffg_fd_opened(int fd)
+{
+    ffg_fd_track(fd);
+#ifdef F_SETNOSIGPIPE
+    fcntl(fd, F_SETNOSIGPIPE, 1);
+#endif
+}
+
