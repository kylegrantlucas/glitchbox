# Load the bundled toolchain environment once build/Glitchbox.app exists (`just app`).
gb=build/Glitchbox.app/Contents/Helpers/glitchbox
watch_file "$gb"
if [ -x "$gb" ]; then
  old_path=$PATH
  eval "$("$gb" env --root "$PWD" --toolchain "$PWD/build/Glitchbox.app/Contents")"
  # Toolchain first, then the rest of your PATH (git, just, editors).
  export PATH="$PATH:$old_path"
else
  log_status "glitchbox: no toolchain yet; run \`just app\`"
fi
