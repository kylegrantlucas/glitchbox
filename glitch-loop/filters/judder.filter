scale=2200:-2:flags=lanczos,
crop=1920:1080:
  x='(iw-ow)/2 + (0.05+0.95*pow(t/112.111,1.8)) * (55*sin(2*PI*t/112.111) + 30*sin(2*PI*t*17/112.111) + 18*sin(2*PI*t*163/112.111) + 10*sin(2*PI*t*719/112.111))':
  y='(ih-oh)/2 + (0.05+0.95*pow(t/112.111,1.8)) * (30*cos(2*PI*t/112.111) + 22*sin(2*PI*t*11/112.111) + 14*cos(2*PI*t*127/112.111) + 45*max(0,sin(2*PI*t*13/112.111)-0.85))',
setsar=1,
format=yuv420p
