{
  "assets" : [],
  "id" : "block-glitch",
  "name" : "Block Glitch",
  "params" : [
    {
      "default" : 0.5,
      "help" : "How often a glitch is applied",
      "key" : "frequency",
      "label" : "Frequency",
      "max" : 1.0,
      "min" : 0.0,
      "step" : 0.01,
      "type" : "float"
    },
    {
      "default" : 0.5,
      "key" : "block_height",
      "label" : "Block height",
      "max" : 1.0,
      "min" : 0.0,
      "step" : 0.01,
      "type" : "float"
    },
    {
      "default" : 0.5,
      "key" : "shift",
      "label" : "Shift intensity",
      "max" : 1.0,
      "min" : 0.0,
      "step" : 0.01,
      "type" : "float"
    },
    {
      "default" : 0.3,
      "key" : "color",
      "label" : "Color glitch",
      "max" : 1.0,
      "min" : 0.0,
      "step" : 0.01,
      "type" : "float"
    }
  ],
  "requires" : [
    "ffmpeg"
  ],
  "schema" : 1,
  "steps" : [
    {
      "argv" : [
        "ffmpeg",
        "-hide_banner",
        "-nostdin",
        "-loglevel",
        "error",
        "-i",
        "{in}",
        "-vf",
        "frei0r=filter_name=glitch0r:filter_params={p.frequency}|{p.block_height}|{p.shift}|{p.color},format=yuv420p",
        "-fflags",
        "+bitexact",
        "-flags:v",
        "+bitexact",
        "-map_metadata",
        "-1",
        "-map_chapters",
        "-1",
        "-c:v",
        "ffv1",
        "-y",
        "{out}"
      ],
      "name" : "filter"
    }
  ],
  "summary" : "Random block shifting and color glitches (frei0r glitch0r). frei0r effect; random-driven effects differ between renders (the cache keeps the first)."
}
