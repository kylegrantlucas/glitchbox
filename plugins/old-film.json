  ],
  "requires" : [
    "ffmpeg"
  ],
  "schema" : 1,
  "simple" : {
    "blurb" : "Projected film: grain, flicker, a wandering frame, and faded colour.",
    "category" : "Film & Light",
    "controls" : [
      {
        "key" : "grain",
        "label" : "Grain"
      },
      {
        "key" : "flicker",
        "label" : "Flicker"
      },
      {
        "key" : "saturation",
        "label" : "Colour"
      },
      {
        "key" : "fade",
        "label" : "Fade"
      }
    ]
  },
  "steps" : [
    {
      "argv" : [
        "ffmpeg",
        "-hide_banner",
        "-nostdin",
        "-loglevel",
        "error",
        "-i",
        "{in}",
        "-vf",
        "split[o][s];[s]eq=saturation={p.saturation}:contrast=1.1:brightness='{p.flicker}*(random(0)-0.5)':eval=frame,curves=all='0/{p.fade} 1/1',colortemperature=temperature={p.temperature},noise=alls={p.grain}:allf=t+u,crop=w=iw-2*floor(iw/60):h=ih-2*floor(ih/60):x='floor(iw/60)*(1+{p.weave}*sin(n/3))':y='floor(ih/60)*(1+{p.weave}*(2*random(1)-1))',vignette=angle={p.vignette}[c];[c][o]scale=rw:rh,format=yuv420p",
        "-fflags",
        "+bitexact",
        "-flags:v",
        "+bitexact",
        "-map_metadata",
        "-1",
        "-map_chapters",
        "-1",
        "-c:v",
        "ffvhuff",
        "-y",
        "{out}"
      ],
      "name" : "filter"
    }
  ],
  "summary" : "Projected film (ffmpeg eq, curves, colortemperature, noise, crop): grain, flicker, gate weave, faded blacks, warm stock, and dark corners."
