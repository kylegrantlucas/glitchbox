  "requires" : [
    "ffmpeg"
  ],
  "schema" : 1,
  "steps" : [
    {
      "argv" : [
        "ffmpeg",
        "-hide_banner",
        "-nostdin",
        "-loglevel",
        "error",
        "-i",
        "{in}",
        "-vf",
        "format=yuv444p,curves=all='0/{p.black} 0.5/0.5 1/{p.white}',rgbashift=rh=-{p.shift}:rv={p.shift_v}:bh={p.shift}:bv=-{p.shift_v}:edge={p.edge},chromashift=cbh={p.chroma}:crh=-{p.chroma}:cbv={p.chroma_v}:crv=-{p.chroma_v}:edge={p.edge},noise=c0s={p.noise}:c0f={p.noise_mode}:c1s={p.chroma_noise}:c1f={p.noise_mode}:c2s={p.chroma_noise}:c2f={p.noise_mode},gblur=sigma={p.blur},deband=range={p.deband}:direction=1.5708:blur=false,eq=contrast={p.contrast}:brightness={p.brightness}:saturation={p.saturation}:gamma={p.gamma},vignette=angle={p.vignette},format=yuv420p",
        "-fflags",
        "+bitexact",
        "-flags:v",
        "+bitexact",
        "-map_metadata",
        "-1",
        "-map_chapters",
        "-1",
        "-c:v",
        "ffv1",
        "-y",
        "{out}"
      ],
      "name" : "vhs"
    }
  ],
  "summary" : "ffmpeg VHS filtergraph (from glitch-loop/filters/vhs2.filter) with levels, misregistration, noise, softness, and vignette controls."
}
